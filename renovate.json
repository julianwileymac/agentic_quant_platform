{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    "schedule:weekdays",
    "group:monorepos"
  ],
  "timezone": "UTC",
  "labels": ["renovate"],
  "rangeStrategy": "auto",
  "lockFileMaintenance": { "enabled": true, "schedule": ["before 5am on monday"] },
  "vulnerabilityAlerts": { "enabled": true, "labels": ["security", "renovate"] },
  "packageRules": [
    {
      "description": "auto-merge minor + patch updates only on aqp-dev",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "matchBaseBranches": ["main"],
      "automerge": true,
      "automergeType": "branch",
      "platformAutomerge": true,
      "matchPackagePatterns": ["^.*"],
      "matchManagers": ["dockerfile", "github-actions", "npm", "pip_requirements", "pep621", "terraform"],
      "schedule": ["before 5am on monday"]
    },
    {
      "description": "never auto-merge major bumps",
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "description": "pin Next.js >=14.2.25 / >=15.2.3 (CVE-2025-29927)",
      "matchPackageNames": ["next"],
      "allowedVersions": ">=15.2.3"
    },
    {
      "description": "pin FastAPI >=0.118 once Solara legacy is removed (Phase 0 cleanup follow-up)",
      "matchPackageNames": ["fastapi"],
      "matchPaths": ["aqp_admin/**"],
      "allowedVersions": ">=0.118.0"
    }
  ],
  "terraform": {
    "rangeStrategy": "pin"
  }
}
