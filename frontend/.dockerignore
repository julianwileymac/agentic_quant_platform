# Excluded from the docker build context. The Dockerfile installs deps
# inside the image (linux node_modules) and then `COPY . .` brings in
# the rest of the source — without this list the host's Windows
# node_modules overwrites the linux one and `tsc` / vite blow up with
# "Cannot find module".
node_modules
.pnpm-store
dist
build
coverage

# IDE / VCS
.git
.gitignore
.idea
.vscode

# Tooling caches
.tsbuildinfo
*.tsbuildinfo
.eslintcache
.cache
.parcel-cache
.turbo

# Test outputs
playwright-report
test-results
.vitest

# Local envs (compose passes the build-args explicitly)
.env
.env.local
.env.development
.env.test
.env.production

# Local notes
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Docker artefacts (shouldn't ship inside the image)
Dockerfile
.dockerignore
