# Vite reads variables prefixed with VITE_ for client-side bundling.
# Override locally via .env.local; do not commit secrets.

# FastAPI base URL (browser-side fetches go via /aqp-api proxy in dev).
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000

# Optional: pin the application mode (live | paper | sandbox).
VITE_DEFAULT_MODE=live

# Optional: external dashboards embedded in iframe panels.
VITE_DASH_URL=http://localhost:8000/dash/
VITE_MLFLOW_URL=http://localhost:5000
VITE_JAEGER_URL=http://localhost:16686
VITE_SUPERSET_URL=http://localhost:8088
