# Vite reads variables prefixed with VITE_ for client-side bundling.
# Override locally via .env.local; do not commit secrets.

# FastAPI base URL (browser-side fetches go via /aqp-api proxy in dev).
# Production Cloudflare Tunnel example: https://api.aqp.fund
VITE_API_URL=http://localhost:8000
# Production Cloudflare Tunnel example: wss://api.aqp.fund
VITE_WS_URL=ws://localhost:8000

# Optional: pin the application mode (live | paper | sandbox).
VITE_DEFAULT_MODE=live

# Optional: external dashboards embedded in iframe panels.
VITE_DASH_URL=http://localhost:8000/dash/
VITE_MLFLOW_URL=http://localhost:5000
VITE_JAEGER_URL=http://localhost:16686
VITE_SUPERSET_URL=http://localhost:8088

# --- Auth0 (frontend) -----------------------------------------------------
# The SPA federates Microsoft Entra ID through Auth0 Universal Login
# (Enterprise Connection). One SDK, one flow. See
# docs/auth0-microsoft-federation.md for the Auth0 dashboard setup.
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
# Production value remains the custom Auth0 API identifier, not the public API hostname:
# https://api.aqp.internal/manage
VITE_AUTH0_AUDIENCE=
# Default: "openid profile email offline_access". Override to add
# Auth0 RBAC scopes (e.g. "read:messages write:messages admin").
VITE_AUTH0_SCOPE=
# Default: ``<window.location.origin>``. Auth0 React processes the
# code+state callback at the app origin, then restores appState.returnTo.
# Production Cloudflare Tunnel example: https://aqp.fund
VITE_AUTH0_REDIRECT_URI=
# Auth0 Organizations (multi-tenant). Most deployments leave empty.
VITE_AUTH0_ORGANIZATION=
# Connection names shown on the login page as "Continue with X" buttons.
VITE_AUTH0_MS_CONNECTION=azure-ad-myorg
VITE_AUTH0_GOOGLE_CONNECTION=google-oauth2
# Optional branding — fall back to "Agentic Quant Platform" / inline svg.
VITE_AUTH0_BRAND_NAME=Agentic Quant Platform
VITE_AUTH0_BRAND_LOGO_URL=
