# Local-dev .env.theia rendered by `aqp-cli ide env`.
# Source: aqp_cli/src/aqp_cli/commands/ide.py::env subcommand.
# Auth0 SPA values are public per PKCE; leaving blank means the AQP
# widgets render their "Auth0 is not configured" gate (intentional for
# offline-first bring-up).
AQP_THEIA_AUTH0_DOMAIN=
AQP_THEIA_AUTH0_CLIENT_ID=
AQP_THEIA_AUTH0_AUDIENCE=
AQP_THEIA_AUTH0_SCOPE=openid profile email offline_access
AQP_THEIA_AUTH0_REDIRECT_URI=http://localhost:3000/
AQP_THEIA_AUTH0_ORGANIZATION=
AQP_THEIA_AUTH0_PUBLIC_ORIGIN=http://localhost:3000
AQP_THEIA_PUBLIC_ORIGIN=http://localhost:3000
# AQP backend — defaults to localhost:8000. The api container is
# currently down (3-day-stale image referencing a refactored module);
# the IDE will surface "API not reachable" gates until the api image
# is rebuilt (docker compose -f aqp_platform/compose/docker-compose.yml build api).
AQP_THEIA_API_URL=http://host.docker.internal:8000
AQP_THEIA_FRONTEND_URL=http://localhost:3001
AQP_THEIA_PROVIDERS_URL=http://host.docker.internal:8000/auth/providers
# AQP MCP bridge — left empty for offline-first; bridge logs structured
# warnings and skips registration. Fill in once aqp-data-mcp and
# aqp-codebase-mcp are reachable.
AQP_THEIA_MCP_DATA_URL=
AQP_THEIA_MCP_DATA_AUDIENCE=
AQP_THEIA_MCP_CODEBASE_URL=
AQP_THEIA_MCP_CODEBASE_AUDIENCE=
# Research copilot routes through router_complete (rule 2); SERA off by default.
AQP_THEIA_SERA_ENABLED=false
AQP_THEIA_ROUTER_COMPLETE_PATH=
