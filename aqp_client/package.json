{
  "name": "aqp-client",
  "version": "0.1.0",
  "private": true,
  "description": "Vite 7 + Tailwind 4 + shadcn/ui client for the Agentic Quant Platform",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3001",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 3001",
    "typecheck": "tsc -b --noEmit",
    "lint": "biome lint ./src ./tests",
    "format": "biome format --write ./src ./tests",
    "format:check": "biome format ./src ./tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "gen:api": "openapi-typescript ../data/openapi.json -o src/lib/api/generated/schema.d.ts"
  },
