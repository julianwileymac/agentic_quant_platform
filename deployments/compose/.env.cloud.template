# =============================================================================
# AQP env — generated by build/scripts/generate_config.py for env=cloud
# Edit deployments/compose/.env.schema; regenerate with `make generate-config`.
# =============================================================================

# Logical environment name. Drives feature flags + telemetry tags.
# REQUIRED (plain)
AQP_ENV=dev

# Python logging level for every AQP service.
# optional (plain)
AQP_LOG_LEVEL=INFO

# Auth enforcement mode (strict|permissive). See aqp/api/security.py.
# optional (plain)
AQP_AUTH_ENFORCE=strict

# Base URL for the AQP core FastAPI API.
# optional (plain)
AQP_CORE_API_URL=http://aqp-core:8000

# Base URL for the AQP ML / testing framework API.
# optional (plain)
AQP_ML_API_URL=http://aqp-ml:8001

# Base URL for the DataMCP HTTP router.
# optional (plain)
AQP_MCP_URL=http://aqp-mcp:8002

# Redis URL — HierarchicalRAG + cache + progress bus.
# REQUIRED (plain)
AQP_REDIS_URL=redis://redis-stack:6379

# Base URL for the aqp_control_plane micro-project.
# optional (plain)
AQP_CONTROL_PLANE_URL=http://aqp-cp:9000

# External Ingress base URL. When set, overrides per-service URLs and derives by path prefix.
# optional (plain)
AQP_INGRESS_BASE_URL=

# Auth0 audience for M2M tokens injected by the proxy into /manage/* calls.
# optional (plain)
AQP_CONTROL_PLANE_M2M_AUDIENCE=https://api.aqp.internal/manage

# SQLAlchemy URL for the canonical Postgres+pgvector instance.
# REQUIRED (plain)
AQP_DATABASE_URL=postgresql+psycopg://aqp:aqp@postgres:5432/aqp

# Postgres password for the AQP application user (when not embedded in DATABASE_URL).
# optional (secret)
AQP_DATABASE_PASSWORD=

# Celery broker URL (defaults to AQP_REDIS_URL).
# optional (plain)
AQP_CELERY_BROKER_URL=redis://redis-stack:6379/0

# Celery result backend URL (defaults to AQP_REDIS_URL).
# optional (plain)
AQP_CELERY_RESULT_URL=redis://redis-stack:6379/1

# Identity provider plugin (auth0 | msal_entra | generic_oidc | mock).
# optional (plain)
AQP_AUTH_PROVIDER=auth0

# Auth0 tenant URL with trailing slash (e.g. https://my-tenant.us.auth0.com/).
# REQUIRED (plain)
AQP_AUTH_OIDC_ISSUER=

# API resource identifier configured in Auth0 (e.g. https://api.aqp.internal/manage).
# REQUIRED (plain)
AQP_AUTH_OIDC_AUDIENCE=https://api.aqp.internal/manage

# SPA application Client ID for Authorization Code + PKCE.
# REQUIRED (plain)
AQP_AUTH_OIDC_CLIENT_ID=

# SPA application Client Secret (only used for confidential M2M flows).
# optional (secret)
AQP_AUTH_OIDC_CLIENT_SECRET=

# Machine-to-machine Client ID for service-to-service Auth0 tokens.
# optional (plain)
AQP_AUTH_M2M_CLIENT_ID=

# M2M Client Secret. Resolved via CredentialResolver (m2m store).
# optional (rotation-required)
AQP_AUTH_M2M_CLIENT_SECRET=

# Auth0 audience used when validating M2M tokens for /_internal/auth0/sync.
# optional (plain)
AQP_AUTH_M2M_AUDIENCE=https://api.aqp.internal/manage

# Canonical custom-claim namespace (default https://aqp.internal/; legacy https://aqp/ still readable for one release).
# optional (plain)
AQP_AUTH_CLAIMS_NAMESPACE=https://aqp.internal/

# Enable the /scim/v2/* router. Requires AQP_AUTH_SCIM_BEARER_TOKEN_HASH.
# optional (plain)
AQP_AUTH_SCIM_ENABLED=false

# SHA-256 hex of the SCIM static bearer token. Resolved via Secret in K8s.
# optional (secret)
AQP_AUTH_SCIM_BEARER_TOKEN_HASH=

# Fernet key used to encrypt the aqp_session cookie. Rotate at most once a quarter.
# optional (rotation-required)
AQP_SESSION_COOKIE_SECRET=

# KubernetesAdapter kind (none | in_cluster | local_compose | rpi_cluster | aws_eks | azure_aks | gcp_gke).
# optional (plain)
AQP_KUBERNETES_ADAPTER=in_cluster

# Path to the canonical deployment topology YAML.
# optional (plain)
AQP_DEPLOYMENT_TOPOLOGY_PATH=configs/deployment/topology.yaml

# Active InfrastructureProvider alias (docker_compose|kubernetes|aws|azure|gcp).
# REQUIRED (plain)
AQP_CP_PROVIDER=docker_compose

# Kubeconfig path used by the kubernetes provider when not in-cluster.
# optional (plain)
AQP_CP_KUBECONFIG_PATH=

# Sample interval for the telemetry streaming task.
# optional (plain)
AQP_CP_TELEMETRY_INTERVAL_SECONDS=10

# Default AWS region for boto3 (EKS / ECS / SSM).
# optional (plain)
AWS_REGION=us-east-1

# AWS access key (use IAM role on EKS / EC2 in production).
# optional (secret)
AWS_ACCESS_KEY_ID=

# AWS secret access key.
# optional (rotation-required)
AWS_SECRET_ACCESS_KEY=

# Role ARN for STS AssumeRole chain.
# optional (plain)
AWS_ROLE_ARN=

# Azure AD tenant id.
# optional (plain)
AZURE_TENANT_ID=

# Azure service principal client id.
# optional (plain)
AZURE_CLIENT_ID=

# Azure service principal client secret.
# optional (rotation-required)
AZURE_CLIENT_SECRET=

# Azure subscription id targeted by the Azure provider.
# optional (plain)
AZURE_SUBSCRIPTION_ID=

# Path to GCP service account JSON.
# optional (plain)
GOOGLE_APPLICATION_CREDENTIALS=

# GCP project id.
# optional (plain)
GOOGLE_CLOUD_PROJECT=

# OTLP/gRPC endpoint for the OpenTelemetry Collector.
# optional (plain)
AQP_OTEL_COLLECTOR_URL=http://otel-collector:4317

# Jaeger UI URL for log links.
# optional (plain)
AQP_JAEGER_UI_URL=http://jaeger:16686

# Whether the Vite SPA blocks unauthenticated users when no IdP config is present.
# optional (plain)
VITE_AUTH_REQUIRED=true

# Relative API base URL for the Vite SPA (always proxied via aqp_client).
# optional (plain)
VITE_AQP_API_BASE_URL=/api

# Auth0 tenant domain (e.g. my-tenant.us.auth0.com) — no protocol.
# optional (plain)
VITE_AUTH0_DOMAIN=

# Auth0 SPA client id for browser-side OIDC.
# optional (plain)
VITE_AUTH0_CLIENT_ID=

# Auth0 audience for SPA-issued access tokens.
# optional (plain)
VITE_AUTH0_AUDIENCE=https://api.aqp.internal/manage
