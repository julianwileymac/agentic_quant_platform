# =============================================================================
# AQP env schema — the SINGLE SOURCE OF TRUTH for every environment variable.
# =============================================================================
# Read by build/scripts/generate_config.py to emit:
#   - .env.local (docker-compose), .env.cloud (sealed-secrets seed)
#   - K8s ConfigMap YAML (non-secret keys)
#   - K8s Secret YAML scaffold (secret keys, base64 values populated by CI/CD)
#
# Format (one logical entry per blank-line-delimited block):
#   key:         AQP_FOO_BAR
#   description: One-line description
#   required:    true | false
#   default:     <value or empty>
#   targets:     comma-separated subset of {local, kubernetes, cloud}
#   classification: plain | secret | rotation-required
#
# Conventions:
#   - All keys are AQP_*-prefixed (except where mandated by external tools, e.g.
#     AUTH0_*, AWS_*, AZURE_*, GOOGLE_*).
#   - Secrets ALWAYS resolve through aqp.credentials.CredentialResolver in
#     application code; this schema is purely about delivery (env -> process).
#   - The default value is ONLY emitted when classification != secret.
# =============================================================================

# -----------------------------------------------------------------------------
# Runtime mode
# -----------------------------------------------------------------------------

key:            AQP_ENV
description:    Logical environment name. Drives feature flags + telemetry tags.
required:       true
default:        dev
targets:        local,kubernetes,cloud
classification: plain

key:            AQP_LOG_LEVEL
description:    Python logging level for every AQP service.
required:       false
default:        INFO
targets:        local,kubernetes,cloud
classification: plain

key:            AQP_AUTH_ENFORCE
description:    Auth enforcement mode (strict|permissive). See aqp/api/security.py.
required:       false
default:        strict
targets:        local,kubernetes,cloud
classification: plain

# -----------------------------------------------------------------------------
# Connectivity matrix (Phase 1 — aqp_platform_core.connectivity)
# -----------------------------------------------------------------------------

key:            AQP_CORE_API_URL
description:    Base URL for the AQP core FastAPI API.
required:       false
default:        http://aqp-core:8000
targets:        local,kubernetes,cloud
classification: plain

key:            AQP_ML_API_URL
description:    Base URL for the AQP ML / testing framework API.
required:       false
default:        http://aqp-ml:8001
targets:        local,kubernetes,cloud
classification: plain

key:            AQP_MCP_URL
description:    Base URL for the DataMCP HTTP router.
required:       false
default:        http://aqp-mcp:8002
targets:        local,kubernetes,cloud
classification: plain

key:            AQP_REDIS_URL
description:    Redis URL — HierarchicalRAG + cache + progress bus.
required:       true
default:        redis://redis-stack:6379
targets:        local,kubernetes,cloud
classification: plain

key:            AQP_CONTROL_PLANE_URL
description:    Base URL for the aqp_control_plane micro-project.
required:       false
default:        http://aqp-cp:9000
targets:        local,kubernetes,cloud
classification: plain

key:            AQP_INGRESS_BASE_URL
description:    External Ingress base URL. When set, overrides per-service URLs and derives by path prefix.
required:       false
default:
targets:        kubernetes,cloud
classification: plain

key:            AQP_CONTROL_PLANE_M2M_AUDIENCE
description:    Auth0 audience for M2M tokens injected by the proxy into /manage/* calls.
required:       false
default:        https://api.aqp.internal/manage
targets:        local,kubernetes,cloud
classification: plain

# -----------------------------------------------------------------------------
# Persistence
# -----------------------------------------------------------------------------

key:            AQP_DATABASE_URL
description:    SQLAlchemy URL for the canonical Postgres+pgvector instance.
required:       true
default:        postgresql+psycopg://aqp:aqp@postgres:5432/aqp
targets:        local,kubernetes,cloud
classification: plain

key:            AQP_DATABASE_PASSWORD
description:    Postgres password for the AQP application user (when not embedded in DATABASE_URL).
required:       false
default:
targets:        local,kubernetes,cloud
classification: secret

key:            AQP_CELERY_BROKER_URL
description:    Celery broker URL (defaults to AQP_REDIS_URL).
required:       false
default:        redis://redis-stack:6379/0
targets:        local,kubernetes,cloud
classification: plain

key:            AQP_CELERY_RESULT_URL
description:    Celery result backend URL (defaults to AQP_REDIS_URL).
required:       false
default:        redis://redis-stack:6379/1
targets:        local,kubernetes,cloud
classification: plain

# -----------------------------------------------------------------------------
# Auth0 / OIDC identity
# -----------------------------------------------------------------------------

key:            AQP_AUTH_PROVIDER
description:    Identity provider plugin (auth0 | msal_entra | generic_oidc | mock).
required:       false
default:        auth0
targets:        local,kubernetes,cloud
classification: plain

key:            AQP_AUTH_OIDC_ISSUER
description:    Auth0 tenant URL with trailing slash (e.g. https://my-tenant.us.auth0.com/).
required:       true
default:
targets:        kubernetes,cloud
classification: plain

key:            AQP_AUTH_OIDC_AUDIENCE
description:    API resource identifier configured in Auth0 (e.g. https://api.aqp.internal/manage).
required:       true
default:        https://api.aqp.internal/manage
targets:        kubernetes,cloud
classification: plain

key:            AQP_AUTH_OIDC_CLIENT_ID
description:    SPA application Client ID for Authorization Code + PKCE.
required:       true
default:
targets:        kubernetes,cloud
classification: plain

key:            AQP_AUTH_OIDC_CLIENT_SECRET
description:    SPA application Client Secret (only used for confidential M2M flows).
required:       false
default:
targets:        kubernetes,cloud
classification: secret

key:            AQP_AUTH_M2M_CLIENT_ID
description:    Machine-to-machine Client ID for service-to-service Auth0 tokens.
required:       false
default:
targets:        kubernetes,cloud
classification: plain

key:            AQP_AUTH_M2M_CLIENT_SECRET
description:    M2M Client Secret. Resolved via CredentialResolver (m2m store).
required:       false
default:
targets:        kubernetes,cloud
classification: rotation-required

key:            AQP_AUTH_M2M_AUDIENCE
description:    Auth0 audience used when validating M2M tokens for /_internal/auth0/sync.
required:       false
default:        https://api.aqp.internal/manage
targets:        kubernetes,cloud
classification: plain

key:            AQP_AUTH_CLAIMS_NAMESPACE
description:    Canonical custom-claim namespace (default https://aqp.internal/; legacy https://aqp/ still readable for one release).
required:       false
default:        https://aqp.internal/
targets:        local,kubernetes,cloud
classification: plain

key:            AQP_AUTH_SCIM_ENABLED
description:    Enable the /scim/v2/* router. Requires AQP_AUTH_SCIM_BEARER_TOKEN_HASH.
required:       false
default:        false
targets:        kubernetes,cloud
classification: plain

key:            AQP_AUTH_SCIM_BEARER_TOKEN_HASH
description:    SHA-256 hex of the SCIM static bearer token. Resolved via Secret in K8s.
required:       false
default:
targets:        kubernetes,cloud
classification: secret

key:            AQP_SESSION_COOKIE_SECRET
description:    Fernet key used to encrypt the aqp_session cookie. Rotate at most once a quarter.
required:       false
default:
targets:        kubernetes,cloud
classification: rotation-required

# -----------------------------------------------------------------------------
# Deployment topology + Kubernetes adapter
# -----------------------------------------------------------------------------

key:            AQP_KUBERNETES_ADAPTER
description:    KubernetesAdapter kind (none | in_cluster | local_compose | rpi_cluster | aws_eks | azure_aks | gcp_gke).
required:       false
default:        in_cluster
targets:        kubernetes,cloud
classification: plain

key:            AQP_DEPLOYMENT_TOPOLOGY_PATH
description:    Path to the canonical deployment topology YAML.
required:       false
default:        configs/deployment/topology.yaml
targets:        local,kubernetes,cloud
classification: plain

key:            AQP_CLUSTER_MGMT_URL
description:    URL of the rpi_kubernetes management API (when AQP_KUBERNETES_ADAPTER=rpi_cluster).
required:       false
default:
targets:        local
classification: plain

key:            AQP_CLUSTER_MGMT_TOKEN
description:    Bearer token for the rpi_kubernetes management API.
required:       false
default:
targets:        local
classification: secret

# -----------------------------------------------------------------------------
# Terraform (provisioning only — AGENTS rule 42)
# -----------------------------------------------------------------------------

key:            AQP_TERRAFORM_BINARY
description:    Path to the terraform binary used by TerraformRuntime.
required:       false
default:        terraform
targets:        local
classification: plain

key:            AQP_TF_PLUGIN_CACHE_DIR
description:    Terraform plugin cache directory (typically data/terraform/plugin-cache-runtime).
required:       false
default:        data/terraform/plugin-cache-runtime
targets:        local
classification: plain

# -----------------------------------------------------------------------------
# Control plane providers (aqp_control_plane — Phase 5)
# -----------------------------------------------------------------------------

key:            AQP_CP_PROVIDER
description:    Active InfrastructureProvider alias (docker_compose|kubernetes|aws|azure|gcp).
required:       true
default:        docker_compose
targets:        local,kubernetes,cloud
classification: plain

key:            AQP_CP_COMPOSE_FILE
description:    Compose file path consulted by the docker_compose provider (only when AQP_CP_PROVIDER=docker_compose).
required:       false
default:        deployments/compose/docker-compose.local.yml
targets:        local
classification: plain

key:            AQP_CP_KUBECONFIG_PATH
description:    Kubeconfig path used by the kubernetes provider when not in-cluster.
required:       false
default:
targets:        local,cloud
classification: plain

key:            AQP_CP_TELEMETRY_INTERVAL_SECONDS
description:    Sample interval for the telemetry streaming task.
required:       false
default:        10
targets:        local,kubernetes,cloud
classification: plain

# -----------------------------------------------------------------------------
# AWS provider
# -----------------------------------------------------------------------------

key:            AWS_REGION
description:    Default AWS region for boto3 (EKS / ECS / SSM).
required:       false
default:        us-east-1
targets:        cloud
classification: plain

key:            AWS_ACCESS_KEY_ID
description:    AWS access key (use IAM role on EKS / EC2 in production).
required:       false
default:
targets:        cloud
classification: secret

key:            AWS_SECRET_ACCESS_KEY
description:    AWS secret access key.
required:       false
default:
targets:        cloud
classification: rotation-required

key:            AWS_ROLE_ARN
description:    Role ARN for STS AssumeRole chain.
required:       false
default:
targets:        cloud
classification: plain

# -----------------------------------------------------------------------------
# Azure provider
# -----------------------------------------------------------------------------

key:            AZURE_TENANT_ID
description:    Azure AD tenant id.
required:       false
default:
targets:        cloud
classification: plain

key:            AZURE_CLIENT_ID
description:    Azure service principal client id.
required:       false
default:
targets:        cloud
classification: plain

key:            AZURE_CLIENT_SECRET
description:    Azure service principal client secret.
required:       false
default:
targets:        cloud
classification: rotation-required

key:            AZURE_SUBSCRIPTION_ID
description:    Azure subscription id targeted by the Azure provider.
required:       false
default:
targets:        cloud
classification: plain

# -----------------------------------------------------------------------------
# GCP provider
# -----------------------------------------------------------------------------

key:            GOOGLE_APPLICATION_CREDENTIALS
description:    Path to GCP service account JSON.
required:       false
default:
targets:        cloud
classification: plain

key:            GOOGLE_CLOUD_PROJECT
description:    GCP project id.
required:       false
default:
targets:        cloud
classification: plain

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------

key:            AQP_OTEL_COLLECTOR_URL
description:    OTLP/gRPC endpoint for the OpenTelemetry Collector.
required:       false
default:        http://otel-collector:4317
targets:        local,kubernetes,cloud
classification: plain

key:            AQP_JAEGER_UI_URL
description:    Jaeger UI URL for log links.
required:       false
default:        http://jaeger:16686
targets:        local,kubernetes,cloud
classification: plain

# -----------------------------------------------------------------------------
# Frontend (Vite — VITE_* gets injected at build time)
# -----------------------------------------------------------------------------

key:            VITE_AUTH_REQUIRED
description:    Whether the Vite SPA blocks unauthenticated users when no IdP config is present.
required:       false
default:        true
targets:        kubernetes,cloud
classification: plain

key:            VITE_AQP_API_BASE_URL
description:    Relative API base URL for the Vite SPA (always proxied via aqp_client).
required:       false
default:        /api
targets:        local,kubernetes,cloud
classification: plain

key:            VITE_AUTH0_DOMAIN
description:    Auth0 tenant domain (e.g. my-tenant.us.auth0.com) — no protocol.
required:       false
default:
targets:        kubernetes,cloud
classification: plain

key:            VITE_AUTH0_CLIENT_ID
description:    Auth0 SPA client id for browser-side OIDC.
required:       false
default:
targets:        kubernetes,cloud
classification: plain

key:            VITE_AUTH0_AUDIENCE
description:    Auth0 audience for SPA-issued access tokens.
required:       false
default:        https://api.aqp.internal/manage
targets:        kubernetes,cloud
classification: plain
