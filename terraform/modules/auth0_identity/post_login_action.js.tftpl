// =============================================================================
// AQP post-login Auth0 Action.
//
// Calls POST <sync_url> with an M2M-issued bearer token. The sync endpoint
// (aqp/api/routes/auth0_sync.py) returns the AQP custom claims to inject:
//
//   org_id, team_id, workspace_id, project_id, lab_id,
//   roles[], resources[], scopes[], connection, internal_user_id, is_new_user
//
// All claims are namespaced under ${claims_namespace} (canonical:
// "https://aqp.internal/" per ADR 003 — legacy "https://aqp/" still
// readable by the validator during the one-release migration window).
//
// The `resources` array is the explicit resource-scoping grant. Every
// list endpoint in aqp_control_plane (and the in-AQP /control-plane/*
// proxy) calls filter_resources(items, payload) to drop items not in
// this array. Operators on aqp-superadmin (admin:cluster scope) bypass.
// =============================================================================
exports.onExecutePostLogin = async (event, api) => {
  const namespace = "${claims_namespace}";
  const body = {
    user_id: event.user.user_id,
    email: event.user.email,
    organization_id: event.organization ? event.organization.id : null,
    organization_name: event.organization ? event.organization.name : null,
    requested_claims: {
      connection: event.connection ? event.connection.name : null,
      strategy: event.connection ? event.connection.strategy : null
    }
  };

  const tokenResponse = await api.authentication.getAccessToken({
    audience: "${api_audience}",
    scope: "data:read scim:write"
  });

  const response = await fetch("${sync_url}", {
    method: "POST",
    headers: {
      "content-type": "application/json",
      "authorization": `Bearer $${tokenResponse.access_token}`
    },
    body: JSON.stringify(body)
  });

  if (!response.ok) {
    console.log(`AQP sync failed: $${response.status}`);
    return;
  }

  const claims = await response.json();
  for (const [key, value] of Object.entries(claims)) {
    if (value === null || value === undefined) {
      continue;
    }
    api.accessToken.setCustomClaim(`${namespace}$${key}`, value);
    api.idToken.setCustomClaim(`${namespace}$${key}`, value);
  }

  // Mirror the `scopes` claim onto the OAuth `scope` string so backend
  // services that only inspect the standard claim see the grant.
  if (Array.isArray(claims.scopes) && claims.scopes.length > 0) {
    const existing = api.accessToken.getCustomClaim
      ? api.accessToken.getCustomClaim("scope") || ""
      : "";
    const existingScopes = typeof existing === "string"
      ? new Set(existing.split(/\s+/).filter(Boolean))
      : new Set();
    for (const s of claims.scopes) {
      existingScopes.add(String(s));
    }
    api.accessToken.setCustomClaim("scope", Array.from(existingScopes).join(" "));
  }
};
