{
  "name": "aqp-admin-frontend",
  "version": "0.2.0",
  "private": true,
  "description": "Next.js 15 App Router admin surface for AQP managed services + company accounts. Replaces the Vite SPA in aqp_admin_ui/ per the aqp_admin overhaul blueprint.",
  "license": "Proprietary",
  "scripts": {
    "dev": "next dev --port 3003",
    "build": "next build",
    "start": "next start --port 3003",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint ./app ./components ./lib ./tests",
    "format": "biome format --write ./app ./components ./lib ./tests",
    "format:check": "biome format ./app ./components ./lib ./tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "openapi:generate": "openapi-typescript http://localhost:8900/openapi.json -o lib/api/generated/schema.ts"
  },
  "dependencies": {
    "@auth0/auth0-react": "^2.2.4",
    "@azure/msal-browser": "^3.27.0",
    "@azure/msal-react": "^2.1.1",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-toast": "^1.2.2",
    "@radix-ui/react-tooltip": "^1.1.4",
    "@tanstack/react-query": "^5.59.0",
    "@tanstack/react-table": "^8.20.5",
    "@tiptap/react": "^2.10.3",
    "@tiptap/starter-kit": "^2.10.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "lightweight-charts": "^4.2.0",
    "lucide-react": "^0.454.0",
    "next": "^15.1.0",
    "openapi-fetch": "^0.13.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.5.4",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^22.7.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^25.0.1",
    "openapi-typescript": "^7.4.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.0.0"
}
