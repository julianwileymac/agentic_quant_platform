# =============================================================================
# aqp_ui environment variables
# Copy to .env.local and fill in real values for local development.
# In production these are populated by External Secrets Operator from Vault.
# =============================================================================

# -- App ----------------------------------------------------------------------
AQP_UI_PORT=3002
AQP_UI_BASE_URL=http://localhost:3002
APP_BASE_URL=http://localhost:3002

# -- Upstream services --------------------------------------------------------
AQP_API_BASE=http://localhost:8000
AQP_CONTROL_PLANE_URL=http://localhost:8800
AQP_WS_URL=ws://localhost:8000

# -- Auth0 (B2C self-signup, Auth0 Organizations = tenants) -------------------
# AGENTS rule 2: identity flows through IdentityProvider; aqp_ui mints PKCE
# state and holds the JWE cookie, never validates JWTs itself.
AUTH0_DOMAIN=aqp-fund.us.auth0.com
AUTH0_CLIENT_ID=replace_me
AUTH0_CLIENT_SECRET=replace_me
AUTH0_AUDIENCE=https://api.aqp.internal
# Generate with: openssl rand -hex 32
AUTH0_SECRET=replace_me_with_a_32_byte_hex_string

# Optional: Auth0 Management API (M2M) for server-side org/member calls
AUTH0_MGMT_API_AUDIENCE=https://aqp-fund.us.auth0.com/api/v2/
AUTH0_MGMT_API_CLIENT_ID=replace_me
AUTH0_MGMT_API_CLIENT_SECRET=replace_me

# -- Entra ID (B2B enterprise SSO, multi-tenant) ------------------------------
# AGENTS rule 44: EntraTenantLink is the only sanctioned ingress.
ENTRA_TENANT_ID=common
ENTRA_CLIENT_ID=replace_me
ENTRA_CLIENT_SECRET=replace_me
ENTRA_AUTHORITY=https://login.microsoftonline.com/common
ENTRA_REDIRECT_URI=http://localhost:3002/api/auth/entra/callback
ENTRA_SCOPES="openid profile email offline_access"

# -- Session encryption (separate from AUTH0_SECRET) --------------------------
# AES-256-GCM key for the unified JWE session cookie.
# Generate with: openssl rand -hex 32
AQP_UI_SESSION_SECRET=replace_me_with_a_32_byte_hex_string
AQP_UI_SESSION_COOKIE_NAME=aqp_ui_session
AQP_UI_SESSION_TTL_SECONDS=604800

# -- Claims namespace ---------------------------------------------------------
# Matches aqp_client/src/lib/auth/useAuth.ts and aqp/auth/providers/protocol.py
AQP_CLAIMS_NAMESPACE=https://aqp.internal/

# -- Feature flags ------------------------------------------------------------
AQP_UI_ENABLE_AUTH0=true
AQP_UI_ENABLE_ENTRA=true
AQP_UI_ENABLE_LOCAL_FALLBACK=true
AQP_UI_DEFAULT_AUTH_PROVIDER=auth0

# -- Logging / observability --------------------------------------------------
LOG_LEVEL=info
OTEL_SERVICE_NAME=aqp-ui
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
