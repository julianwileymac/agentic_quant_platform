{
  "name": "aqp-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Cloud-hosted, multi-tenant PaaS frontend for the Agentic Quant Platform (Next.js 14+ App Router)",
  "license": "Proprietary",
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3002",
    "build": "next build",
    "start": "next start --port 3002",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint ./src ./tests",
    "format": "biome format --write ./src ./tests",
    "format:check": "biome format ./src ./tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "gen:api": "openapi-typescript ../data/openapi.json -o src/lib/api/generated/schema.d.ts"
  },
  "dependencies": {
    "next": "14.2.30",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@auth0/nextjs-auth0": "^4.0.0",
    "@azure/msal-node": "^2.13.0",
    "antd": "^5.20.0",
    "@ant-design/nextjs-registry": "^1.0.2",
    "@ant-design/icons": "^5.5.1",
    "@rjsf/antd": "^5.21.2",
    "@rjsf/core": "^5.21.2",
    "@rjsf/utils": "^5.21.2",
    "@rjsf/validator-ajv8": "^5.21.2",
    "@tanstack/react-query": "^5.59.0",
    "@tanstack/react-query-devtools": "^5.59.0",
    "zustand": "^5.0.0",
    "yaml": "^2.5.1",
    "openapi-fetch": "^0.13.0",
    "lucide-react": "^0.454.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.5.4",
    "dayjs": "^1.11.13",
    "jose": "^5.9.0",
    "iron-session": "^8.0.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@playwright/test": "^1.48.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.7.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^25.0.1",
    "openapi-typescript": "^7.4.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.0.0"
}
