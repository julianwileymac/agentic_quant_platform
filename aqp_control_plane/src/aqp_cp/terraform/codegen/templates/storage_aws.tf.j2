{# AWS storage primitives — RDS Postgres 16 + S3 + ElastiCache Redis 7.1.
   Mirrors aqp/terraform/codegen/templates/storage_aws.tf.j2 so the
   spec hash matches whether the monolith broker or the CP-native
   executor rendered the bundle. #}

# --- AWS storage primitives ---------------------------------------------
# RDS Postgres + S3 bucket + ElastiCache Redis. Cost-optimised defaults.

resource "aws_db_instance" "{{ spec.slug | replace('-', '_') }}_pg" {
  identifier            = "{{ spec.slug }}-pg"
  engine                = "postgres"
  engine_version        = "16.3"
  instance_class        = "db.t4g.medium"
  allocated_storage     = 50
  storage_encrypted     = true
  multi_az              = false
  publicly_accessible   = false
  backup_retention_period = 7
  deletion_protection   = true
  parameter_group_name  = aws_db_parameter_group.{{ spec.slug | replace('-', '_') }}_pg.name
  tags                  = local.common_tags
  # NB: db_name / username / password come from ExternalSecret /
  # AWS Secrets Manager — never inline.
}

resource "aws_db_parameter_group" "{{ spec.slug | replace('-', '_') }}_pg" {
  family = "postgres16"
  name   = "{{ spec.slug }}-pg"
  parameter {
    name  = "pg_stat_statements.track"
    value = "all"
  }
  parameter {
    name  = "shared_preload_libraries"
    value = "pg_stat_statements"
    apply_method = "pending-reboot"
  }
  tags = local.common_tags
}

resource "aws_s3_bucket" "{{ spec.slug | replace('-', '_') }}_lake" {
  bucket = "{{ spec.slug }}-aqp-lake"
  tags   = local.common_tags
}

resource "aws_s3_bucket_versioning" "{{ spec.slug | replace('-', '_') }}_lake" {
  bucket = aws_s3_bucket.{{ spec.slug | replace('-', '_') }}_lake.id
  versioning_configuration { status = "Enabled" }
}

resource "aws_s3_bucket_server_side_encryption_configuration" "{{ spec.slug | replace('-', '_') }}_lake" {
  bucket = aws_s3_bucket.{{ spec.slug | replace('-', '_') }}_lake.id
  rule {
    apply_server_side_encryption_by_default { sse_algorithm = "AES256" }
  }
}

resource "aws_s3_bucket_public_access_block" "{{ spec.slug | replace('-', '_') }}_lake" {
  bucket                  = aws_s3_bucket.{{ spec.slug | replace('-', '_') }}_lake.id
  block_public_acls       = true
  block_public_policy     = true
  ignore_public_acls      = true
  restrict_public_buckets = true
}

resource "aws_s3_bucket_lifecycle_configuration" "{{ spec.slug | replace('-', '_') }}_lake" {
  bucket = aws_s3_bucket.{{ spec.slug | replace('-', '_') }}_lake.id
  rule {
    id     = "archive-old"
    status = "Enabled"
    filter {}
    transition {
      days          = 90
      storage_class = "GLACIER_IR"
    }
  }
}

resource "aws_elasticache_replication_group" "{{ spec.slug | replace('-', '_') }}_redis" {
  replication_group_id       = "{{ spec.slug }}-redis"
  description                = "AQP Redis broker + RAG vector store"
  engine                     = "redis"
  engine_version             = "7.1"
  node_type                  = "cache.t4g.small"
  parameter_group_name       = "default.redis7"
  num_cache_clusters         = 2
  automatic_failover_enabled = true
  at_rest_encryption_enabled = true
  transit_encryption_enabled = true
  tags                       = local.common_tags
}
