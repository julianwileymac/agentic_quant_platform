{# Secrets — External Secrets Operator + per-secret ExternalSecret rows
   sourced from a vault backend. Cloud-specific backend selection lives
   in the matching secrets_aws / secrets_azure / secrets_gcp templates
   (each only re-defines the ClusterSecretStore body). Variables:
   - namespace
   - vault_backend           ("vault" | "aws_secretsmanager" | "gcp_secretmanager" | "azure_keyvault")
   - secret_mappings         (map of { k8s_secret_name = { vault_path, k8s_key } })
-#}

locals {
  common_tags = {{ tags | tfmap }}
  namespace_name = lookup({{ variables | tfmap }}, "namespace", "aqp-{{ spec.environment }}")
  vault_backend  = lookup({{ variables | tfmap }}, "vault_backend", "vault")
  default_mappings = {
    "aqp-broker-api-key"    = { vault_path = "aqp/broker/api_key",    k8s_key = "AQP_BROKER_API_KEY" }
    "aqp-broker-api-secret" = { vault_path = "aqp/broker/api_secret", k8s_key = "AQP_BROKER_API_SECRET" }
    "aqp-db-password"       = { vault_path = "aqp/database/password", k8s_key = "AQP_DB_PASSWORD" }
    "aqp-msal-client-secret" = { vault_path = "aqp/msal/client_secret", k8s_key = "AQP_MSAL_CLIENT_SECRET" }
    "aqp-redis-password"    = { vault_path = "aqp/redis/password",    k8s_key = "AQP_REDIS_PASSWORD" }
  }
  mappings = length(lookup({{ variables | tfmap }}, "secret_mappings", {})) > 0 ? lookup({{ variables | tfmap }}, "secret_mappings", {}) : local.default_mappings
}

resource "kubernetes_namespace" "external_secrets" {
  metadata {
    name = "external-secrets"
    labels = {
      "app.kubernetes.io/part-of" = "aqp"
    }
  }
}

resource "helm_release" "external_secrets" {
  name       = "external-secrets"
  repository = "https://charts.external-secrets.io"
  chart      = "external-secrets"
  version    = lookup({{ variables | tfmap }}, "eso_version", "0.10.0")
  namespace  = kubernetes_namespace.external_secrets.metadata[0].name
  values = [
    yamlencode({
      installCRDs = true
    })
  ]
}

resource "kubernetes_manifest" "cluster_secret_store" {
  manifest = {
    apiVersion = "external-secrets.io/v1beta1"
    kind       = "ClusterSecretStore"
    metadata   = { name = "aqp-secret-store" }
    spec = {
      provider = local.vault_backend == "vault" ? {
        vault = {
          server  = lookup({{ variables | tfmap }}, "vault_addr", "http://vault.vault.svc.cluster.local:8200")
          path    = lookup({{ variables | tfmap }}, "vault_mount", "secret")
          version = "v2"
        }
      } : (local.vault_backend == "aws_secretsmanager" ? {
        aws = {
          service = "SecretsManager"
          region  = lookup({{ variables | tfmap }}, "aws_region", "us-east-1")
          auth    = { jwt = { serviceAccountRef = { name = "external-secrets" } } }
        }
      } : (local.vault_backend == "gcp_secretmanager" ? {
        gcpsm = {
          projectID = lookup({{ variables | tfmap }}, "gcp_project_id", "")
          auth      = { workloadIdentity = { clusterLocation = lookup({{ variables | tfmap }}, "gcp_region", "us-central1"), clusterName = lookup({{ variables | tfmap }}, "gcp_gke_cluster_name", ""), serviceAccountRef = { name = "external-secrets" } } }
        }
      } : {
        azurekv = {
          authType = "WorkloadIdentity"
          vaultUrl = lookup({{ variables | tfmap }}, "azure_keyvault_url", "")
          tenantId = lookup({{ variables | tfmap }}, "azure_tenant_id", "")
          serviceAccountRef = { name = "external-secrets", namespace = kubernetes_namespace.external_secrets.metadata[0].name }
        }
      }))
    }
  }

  depends_on = [helm_release.external_secrets]
}

resource "kubernetes_manifest" "external_secrets_per_key" {
  for_each = local.mappings
  manifest = {
    apiVersion = "external-secrets.io/v1beta1"
    kind       = "ExternalSecret"
    metadata   = { name = each.key, namespace = local.namespace_name }
    spec = {
      refreshInterval = "1h"
      secretStoreRef  = { name = "aqp-secret-store", kind = "ClusterSecretStore" }
      target          = { name = each.key, creationPolicy = "Owner" }
      data = [{
        secretKey = each.value.k8s_key
        remoteRef = { key = each.value.vault_path }
      }]
    }
  }

  depends_on = [kubernetes_manifest.cluster_secret_store]
}

output "secret_store_kind" {
  value = local.vault_backend
}

output "synced_secrets" {
  value = keys(local.mappings)
}
