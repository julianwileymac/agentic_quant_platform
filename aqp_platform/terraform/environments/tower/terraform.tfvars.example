# Copy to aqp_platform/terraform/environments/tower/terraform.tfvars and adjust values.
kubeconfig_path = "~/.kube/aqp-tower.config"
kube_context    = ""
namespace       = "aqp"

app_version    = "replace-with-immutable-tag"
image_registry = "docker.io/julian0215"
ingress_host   = "aqp.fund"

auth0_domain    = "aqp-fund.us.auth0.com"
auth0_audience  = "https://api.aqp.internal/manage"
auth0_client_id = "ZwJvVAYGRj6drndJhpKlvyLv18Jybavz"

# Dual-host transition inputs for aqp_platform/terraform/modules/auth0_identity when
# running blue/green callback updates in the identity stack.
# callback_urls = ["https://aqp.fund", "https://manage.aqp.fund"]
# cutover_callback_urls = ["https://aqp-green.aqp.fund", "https://manage-green.aqp.fund"]
# logout_urls = ["https://aqp.fund", "https://manage.aqp.fund"]
# cutover_logout_urls = ["https://aqp-green.aqp.fund", "https://manage-green.aqp.fund"]
# web_origins = ["https://aqp.fund", "https://api.aqp.fund", "https://manage.aqp.fund"]
# cutover_web_origins = ["https://aqp-green.aqp.fund", "https://api-green.aqp.fund", "https://manage-green.aqp.fund"]

# Set when the secrets already exist in-cluster.
auth0_client_secret_secret_name         = "auth0-client-secret"
auth_scim_bearer_token_hash_secret_name = "auth0-scim-bearer-token-hash"

enabled_services = [
  "aqp-core",
  "aqp-worker",
  "aqp-beat",
  "aqp-client",
  "aqp-cp",
  "postgres",
  "redis",
  "neo4j",
  "chromadb",
  "mlflow",
  "otel-collector",
  "jaeger",
  "questdb",
]

# Blue/green-ready cloudflare examples (disabled by default).
cloudflare_enabled = false
# cloudflare_account_id = "00000000000000000000000000000000"
# cloudflare_zone_id    = "00000000000000000000000000000000"
# cloudflare_tunnel_name = "aqp-fund-edge"
# cloudflare_ingress_rules = [
#   { hostname = "aqp-green.fund", service = "http://aqp-client.aqp.svc.cluster.local:80" },
#   { hostname = "api-green.aqp.fund", service = "http://aqp-core.aqp.svc.cluster.local:8000" },
#   { hostname = "manage-green.aqp.fund", service = "http://aqp-cp.aqp-admin.svc.cluster.local:80" },
# ]
