# =============================================================================
# AQP env — generated by build/scripts/generate_config.py for env=local
# Edit deployments/compose/.env.schema; regenerate with `make generate-config`.
# =============================================================================

# Logical environment name. Drives feature flags + telemetry tags.
# REQUIRED (plain)
AQP_ENV=dev

# Python logging level for every AQP service.
# optional (plain)
AQP_LOG_LEVEL=INFO

# Auth enforcement mode (strict|permissive). See aqp/api/security.py.
# optional (plain)
AQP_AUTH_ENFORCE=strict

# Base URL for the AQP core FastAPI API.
# optional (plain)
AQP_CORE_API_URL=http://aqp-core:8000

# Base URL for the AQP ML / testing framework API.
# optional (plain)
AQP_ML_API_URL=http://aqp-ml:8001

# Base URL for the DataMCP HTTP router.
# optional (plain)
AQP_MCP_URL=http://aqp-mcp:8002

# Redis URL — HierarchicalRAG + cache + progress bus.
# REQUIRED (plain)
AQP_REDIS_URL=redis://redis-stack:6379

# Base URL for the aqp_control_plane micro-project.
# optional (plain)
AQP_CONTROL_PLANE_URL=http://aqp-cp:9000

# Auth0 audience for M2M tokens injected by the proxy into /manage/* calls.
# optional (plain)
AQP_CONTROL_PLANE_M2M_AUDIENCE=https://api.aqp.internal/manage

# SQLAlchemy URL for the canonical Postgres+pgvector instance.
# REQUIRED (plain)
AQP_DATABASE_URL=postgresql+psycopg://aqp:aqp@postgres:5432/aqp

# Postgres password for the AQP application user (when not embedded in DATABASE_URL).
# optional (secret)
# AQP_DATABASE_PASSWORD=<set-via-secret-store>

# Celery broker URL (defaults to AQP_REDIS_URL).
# optional (plain)
AQP_CELERY_BROKER_URL=redis://redis-stack:6379/0

# Celery result backend URL (defaults to AQP_REDIS_URL).
# optional (plain)
AQP_CELERY_RESULT_URL=redis://redis-stack:6379/1

# Identity provider plugin (auth0 | msal_entra | generic_oidc | mock).
# optional (plain)
AQP_AUTH_PROVIDER=auth0

# Canonical custom-claim namespace (default https://aqp.internal/; legacy https://aqp/ still readable for one release).
# optional (plain)
AQP_AUTH_CLAIMS_NAMESPACE=https://aqp.internal/

# Path to the canonical deployment topology YAML.
# optional (plain)
AQP_DEPLOYMENT_TOPOLOGY_PATH=configs/deployment/topology.yaml

# URL of the rpi_kubernetes management API (when AQP_KUBERNETES_ADAPTER=rpi_cluster).
# optional (plain)
AQP_CLUSTER_MGMT_URL=

# Bearer token for the rpi_kubernetes management API.
# optional (secret)
# AQP_CLUSTER_MGMT_TOKEN=<set-via-secret-store>

# Path to the terraform binary used by TerraformRuntime.
# optional (plain)
AQP_TERRAFORM_BINARY=terraform

# Terraform plugin cache directory (typically data/terraform/plugin-cache-runtime).
# optional (plain)
AQP_TF_PLUGIN_CACHE_DIR=data/terraform/plugin-cache-runtime

# Active InfrastructureProvider alias (docker_compose|kubernetes|aws|azure|gcp).
# REQUIRED (plain)
AQP_CP_PROVIDER=docker_compose

# Compose file path consulted by the docker_compose provider (only when AQP_CP_PROVIDER=docker_compose).
# optional (plain)
AQP_CP_COMPOSE_FILE=deployments/compose/docker-compose.local.yml

# Kubeconfig path used by the kubernetes provider when not in-cluster.
# optional (plain)
AQP_CP_KUBECONFIG_PATH=

# Sample interval for the telemetry streaming task.
# optional (plain)
AQP_CP_TELEMETRY_INTERVAL_SECONDS=10

# OTLP/gRPC endpoint for the OpenTelemetry Collector.
# optional (plain)
AQP_OTEL_COLLECTOR_URL=http://otel-collector:4317

# Jaeger UI URL for log links.
# optional (plain)
AQP_JAEGER_UI_URL=http://jaeger:16686

# Relative API base URL for the Vite SPA (always proxied via aqp_client).
# optional (plain)
VITE_AQP_API_BASE_URL=/api
