{
  "type": "record",
  "name": "AlphaVantageOverviewV1",
  "namespace": "aqp.streaming.alphavantage",
  "doc": "Company fundamental overview from OVERVIEW endpoint. Log-compacted topic keyed by symbol.",
  "fields": [
    {"name": "ts_ns", "type": "long"},
    {"name": "symbol", "type": "string"},
    {"name": "name", "type": ["null", "string"], "default": null},
    {"name": "description", "type": ["null", "string"], "default": null},
    {"name": "asset_type", "type": ["null", "string"], "default": null},
    {"name": "exchange", "type": ["null", "string"], "default": null},
    {"name": "currency", "type": ["null", "string"], "default": null},
    {"name": "country", "type": ["null", "string"], "default": null},
    {"name": "sector", "type": ["null", "string"], "default": null},
    {"name": "industry", "type": ["null", "string"], "default": null},
    {"name": "cik", "type": ["null", "string"], "default": null},
    {"name": "market_capitalization", "type": ["null", "string"], "default": null},
    {"name": "ebitda", "type": ["null", "string"], "default": null},
    {"name": "pe_ratio", "type": ["null", "string"], "default": null},
    {"name": "peg_ratio", "type": ["null", "string"], "default": null},
    {"name": "book_value", "type": ["null", "string"], "default": null},
    {"name": "dividend_per_share", "type": ["null", "string"], "default": null},
    {"name": "dividend_yield", "type": ["null", "string"], "default": null},
    {"name": "eps", "type": ["null", "string"], "default": null},
    {"name": "profit_margin", "type": ["null", "string"], "default": null},
    {"name": "operating_margin_ttm", "type": ["null", "string"], "default": null},
    {"name": "return_on_assets_ttm", "type": ["null", "string"], "default": null},
    {"name": "return_on_equity_ttm", "type": ["null", "string"], "default": null},
    {"name": "revenue_ttm", "type": ["null", "string"], "default": null},
    {"name": "gross_profit_ttm", "type": ["null", "string"], "default": null},
    {"name": "diluted_eps_ttm", "type": ["null", "string"], "default": null},
    {"name": "quarterly_earnings_growth_yoy", "type": ["null", "string"], "default": null},
    {"name": "quarterly_revenue_growth_yoy", "type": ["null", "string"], "default": null},
    {"name": "analyst_target_price", "type": ["null", "string"], "default": null},
    {"name": "beta", "type": ["null", "string"], "default": null},
    {"name": "fifty_two_week_high", "type": ["null", "string"], "default": null},
    {"name": "fifty_two_week_low", "type": ["null", "string"], "default": null},
    {"name": "shares_outstanding", "type": ["null", "string"], "default": null},
    {"name": "dividend_date", "type": ["null", "string"], "default": null},
    {"name": "ex_dividend_date", "type": ["null", "string"], "default": null},
    {"name": "latest_quarter", "type": ["null", "string"], "default": null},
    {"name": "fiscal_year_end", "type": ["null", "string"], "default": null},
    {"name": "av_function", "type": "string", "default": "OVERVIEW"},
    {"name": "ingest_ts_ns", "type": "long"}
  ]
}
