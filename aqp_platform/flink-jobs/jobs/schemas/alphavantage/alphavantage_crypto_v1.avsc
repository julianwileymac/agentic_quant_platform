{
  "type": "record",
  "name": "AlphaVantageCryptoV1",
  "namespace": "aqp.streaming.alphavantage",
  "doc": "Crypto snapshot or OHLCV bar. quote_kind distinguishes realtime exchange rates from CRYPTO_INTRADAY/DIGITAL_CURRENCY_DAILY|WEEKLY|MONTHLY bars.",
  "fields": [
    {"name": "ts_ns", "type": "long"},
    {"name": "symbol", "type": "string"},
    {"name": "market", "type": "string"},
    {"name": "quote_kind", "type": {
      "type": "enum",
      "name": "CryptoQuoteKind",
      "symbols": ["REALTIME", "INTRADAY", "DAILY", "WEEKLY", "MONTHLY"]
    }},
    {"name": "interval", "type": ["null", "string"], "default": null},
    {"name": "open", "type": ["null", "double"], "default": null},
    {"name": "high", "type": ["null", "double"], "default": null},
    {"name": "low", "type": ["null", "double"], "default": null},
    {"name": "close", "type": ["null", "double"], "default": null},
    {"name": "volume", "type": ["null", "double"], "default": null},
    {"name": "market_cap", "type": ["null", "double"], "default": null},
    {"name": "exchange_rate", "type": ["null", "double"], "default": null},
    {"name": "bid_price", "type": ["null", "double"], "default": null},
    {"name": "ask_price", "type": ["null", "double"], "default": null},
    {"name": "av_function", "type": "string"},
    {"name": "ingest_ts_ns", "type": "long"}
  ]
}
