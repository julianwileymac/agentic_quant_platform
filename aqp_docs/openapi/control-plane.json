{
  "openapi": "3.0.3",
  "info": {
    "title": "AQP Control-Plane API",
    "description": "Workload lifecycle + Terraform driver + provider adapters + audit ledger. Served at manage.aqp.fund. Owns the workload_runs ledger (AGENTS rule 45).",
    "version": "2026-06-01",
    "contact": { "name": "AQP Platform Team", "url": "https://docs.aqp.fund" },
